rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        getUserData().role == 'teacher'
      );
    }

    function isParent() {
      return isAuthenticated() && (
        request.auth.token.role == 'parent' ||
        getUserData().role == 'parent'
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        request.auth.token.role == 'student' ||
        getUserData().role == 'student'
      );
    }

    function isParentOf(studentId) {
      return isParent() && (
        request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.parentUids ||
        studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentIds
      );
    }

    function isAssignedTeacher(batchId) {
      return isTeacher() && (
        request.auth.uid in get(/databases/$(database)/documents/batches/$(batchId)).data.teacherUids ||
        batchId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.assignedBatchIds
      );
    }

    // 1. Users collection
    match /users/{uid} {
      allow read: if isAuthenticated() && (isUser(uid) || isAdmin());
      // Users can update basic profile info, but CANNOT change their role or account status
      allow update: if isUser(uid) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus']);
      allow create, delete: if isAdmin();
    }

    // 2. Students collection
    match /students/{studentId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.userUid == request.auth.uid) ||
        isParentOf(studentId) ||
        isTeacher();
      allow write: if isAdmin();
    }

    // 3. Parents collection
    match /parents/{parentUid} {
      allow read: if isUser(parentUid) || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Teachers collection
    match /teachers/{teacherUid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Subjects & Batches
    match /subjects/{subjectId} {
      allow read: if true; // Publicly readable for curriculum
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /enrolments/{enrolmentId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && isParentOf(resource.data.studentId)) ||
        isTeacher();
      allow write: if isAdmin();
    }

    // 6. Admission Enquiries
    match /admission_enquiries/{enquiryId} {
      // Public visitors can ONLY create an enquiry with valid fields
      allow create: if request.resource.data.keys().hasAll(['studentName', 'guardianName', 'contactNumber', 'classLevel']) &&
        request.resource.data.status == 'NEW' &&
        request.resource.data.contactNumber.size() >= 10;
      // Only admins can view, update or close enquiries
      allow read, update, delete: if isAdmin();
    }

    // 7. Attendance
    match /attendance/{attendanceId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && isParentOf(resource.data.studentId)) ||
        isAssignedTeacher(resource.data.batchId);
      // Teachers can mark attendance for assigned batches
      allow create: if isAdmin() || isAssignedTeacher(request.resource.data.batchId);
      // Corrections can be requested or made by admin
      allow update: if isAdmin() || (
        isAssignedTeacher(resource.data.batchId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correctionStatus', 'correctionNotes'])
      );
      allow delete: if isAdmin();
    }

    // 8. Homework & Submissions
    match /homework/{homeworkId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isAssignedTeacher(request.resource.data.batchId);
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && isParentOf(resource.data.studentId)) ||
        isTeacher();
      // Students can submit or resubmit their own homework before deadline
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if (isStudent() && resource.data.studentId == request.auth.uid && resource.data.status != 'GRADED') ||
        isAdmin() ||
        isTeacher(); // Teacher grades submission
      allow delete: if isAdmin();
    }

    // 9. Tests & Results
    match /tests/{testId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isAssignedTeacher(request.resource.data.batchId);
    }

    match /results/{resultId} {
      // Students and parents can only see results when published
      allow read: if isAdmin() || isTeacher() ||
        (resource.data.publishedAt != null && (
          (isStudent() && resource.data.studentId == request.auth.uid) ||
          (isParent() && isParentOf(resource.data.studentId))
        ));
      // Teachers can enter marks, Admin can publish
      allow write: if isAdmin() || isTeacher();
    }

    // 10. Fees & Invoices
    match /fee_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /fee_invoices/{invoiceId} {
      allow read: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && isParentOf(resource.data.studentId));
      // Invoices can only be created, modified or deleted by trusted admin / backend
      allow write: if isAdmin();
    }

    // 11. Payments & Orders
    match /payment_orders/{orderId} {
      allow read: if isAdmin() ||
        (isParent() && isParentOf(resource.data.studentId)) ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin(); // Serverless backend handles creation
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (isParent() && isParentOf(resource.data.studentId)) ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin(); // Serverless backend handles verification
    }

    match /payment_events/{eventId} {
      allow read, write: if isAdmin(); // Strictly backend webhook verification
    }

    match /receipt_records/{receiptId} {
      allow read: if isAdmin() ||
        (isParent() && isParentOf(resource.data.studentId)) ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin(); // Only backend issues receipts
    }

    // 12. Supporting Collections
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only via Admin SDK in Cloud Functions
    }

    match /parent_link_requests/{requestId} {
      allow read: if isAdmin() || (isParent() && resource.data.parentPhone == request.auth.token.phone_number);
      allow create: if isParent();
      allow update, delete: if isAdmin();
    }
  }
}
