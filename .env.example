# Radiance Institute — Environment Configuration Template
# Copy this file to .env or configure in your deployment platform
# DO NOT commit real secrets to source control.

# ==========================================
# 1. Firebase Project & Authentication
# ==========================================
FIREBASE_PROJECT_ID=radiance-institute-sandbox
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@radiance-institute-sandbox.iam.gserviceaccount.com
# For local development with emulators:
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ==========================================
# 2. Razorpay Gateway (Sandbox / Production)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId123
RAZORPAY_KEY_SECRET=placeholderSecretKey456
RAZORPAY_WEBHOOK_SECRET=placeholderWebhookSecret789

# ==========================================
# 3. Radiance Institute Official Info
# ==========================================
INSTITUTE_NAME="Radiance Institute"
INSTITUTE_TAGLINE="Committed to Quality Education"
INSTITUTE_PHONE="+91 183 508 0005"
INSTITUTE_EMAIL="info@radianceinstitute.net"
INSTITUTE_ADDRESS="85-A, Rani Ka Bagh, adjoining FCI Office, Amritsar, Punjab, India"
